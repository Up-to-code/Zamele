{
  "expo": {
    "name": "Zamele",
    "slug": "Zamele",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zamele",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ahmedss7.Zamele"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Zamele.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#4157B2"
          
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
